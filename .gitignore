# --- Local runtime data (never commit) -------------------------------------
# Session history holds your actual conversation transcripts.
data/
# PID files and service logs written by local-stack/start.ps1.
local-stack/logs/
local-stack/run/
# State snapshots taken before risky upgrades (SQLite DB copies, credentials).
local-stack/.backup-9router-state-*/
# Machine-specific tuning (session limits). Ships as settings.local.example.ps1.
local-stack/settings.local.ps1
# Editor/OS noise.
*.bak
*.bak-*
*.log
Thumbs.db

# --- Nested checkouts (never commit) ---------------------------------------
# 9router-source/ is a separate git clone of serenhope/9router kept next to the
# proxy so everything lives in one folder. It has its own history and upstream,
# so committing it would nest one repo inside another. Clone it yourself:
#   git clone https://github.com/serenhope/9router.git 9router-source
9router-source/

